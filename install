#!/bin/bash

# Install NittyGriddy, the focused-window frame, Tokyo Night, Quake console,
# and the Nautilus background.
# Safe to run again. It copies files into place and does not remove them.

set -euo pipefail

root=$(cd "$(dirname "$0")" && pwd)
home=${HOME:?}

read_field() {
  local file=$1
  local key=$2
  local line
  line=$(grep -E "^${key}=" "$file")
  printf '%s' "${line#*=}"
}

plugin_id=$(read_field "$root/plugin/timsonner.nitty-griddy" id)
plugin_url=$(read_field "$root/plugin/timsonner.nitty-griddy" url)
plugin_commit=$(read_field "$root/plugin/timsonner.nitty-griddy" commit)
quake_url=$(read_field "$root/quake-console" url)
quake_commit=$(read_field "$root/quake-console" commit)
theme=$(sed -n '1{s/[[:space:]]*$//;p;}' "$root/theme")

install -d "$home/.config/hypr"
install -m 644 "$root/hypr/gestures.lua" "$home/.config/hypr/gestures.lua"
install -m 644 "$root/hypr/frame.lua" "$home/.config/hypr/frame.lua"
install -m 644 "$root/hypr/focus.lua" "$home/.config/hypr/focus.lua"

install -d "$home/.config/gtk-4.0"
python3 - "$home/.config/gtk-4.0/gtk.css" "$root/gtk/nautilus.css" << 'PY'
import pathlib, sys

path, source = map(pathlib.Path, sys.argv[1:3])
start = "/* omarchy-desktop: nautilus */\n"
end = "/* omarchy-desktop: nautilus end */\n"
block = start + source.read_text().strip() + "\n" + end
if path.exists():
    text = path.read_text()
else:
    text = ""
if start in text and end in text:
    pre, rest = text.split(start, 1)
    _, post = rest.split(end, 1)
    text = pre + block + post
    if pre and not pre.endswith("\n"):
        text = pre + "\n" + block + post
elif text.strip() in ("", source.read_text().strip()):
    text = block
else:
    if text and not text.endswith("\n"):
        text += "\n"
    text += "\n" + block
if not text.endswith("\n"):
    text += "\n"
path.write_text(text)
PY

python3 - "$home/.config/hypr/hyprland.lua" "$home/.config/hypr/input.lua" "$home/.config/hypr/looknfeel.lua" << 'PY'
import pathlib, sys

hypr_path, input_path, look_path = map(pathlib.Path, sys.argv[1:4])

def strip_from(path, marker):
    if not path.exists():
        print(f"missing {path}", file=sys.stderr)
        sys.exit(1)
    text = path.read_text()
    at = text.find(marker)
    if at == -1:
        return
    cut = text.rfind("\n", 0, at)
    kept = text[: cut + 1] if cut != -1 else ""
    if kept and not kept.endswith("\n"):
        kept += "\n"
    path.write_text(kept)

strip_from(input_path, "-- Three-finger swipe up shows the open windows (Exposé).")
strip_from(look_path, "-- 6px frame on the focused window only")

block = (
    "\n-- Three-finger up opens NittyGriddy. Three-finger down dismisses it.\n"
    'require("hypr.gestures")\n'
    'require("hypr.frame")\n'
)
text = hypr_path.read_text()
if 'require("hypr.gestures")' not in text and 'require("hypr.frame")' not in text:
    if not text.endswith("\n"):
        text += "\n"
    text += block
    hypr_path.write_text(text)
elif 'require("hypr.gestures")' not in text or 'require("hypr.frame")' not in text:
    print("hyprland.lua requires only one of gestures.lua and frame.lua", file=sys.stderr)
    sys.exit(1)

text = hypr_path.read_text()
if 'require("hypr.focus")' not in text:
    if not text.endswith("\n"):
        text += "\n"
    text += "\n-- The window you select gets focus, and a floating one comes forward.\n"
    text += 'require("hypr.focus")\n'
    hypr_path.write_text(text)
PY

plugin_dir="$home/.config/omarchy/plugins/$plugin_id"
if [[ ! -d $plugin_dir ]]; then
  omarchy plugin add "$plugin_url" --enable --yes
fi

if [[ -d $plugin_dir/.git ]]; then
  head=$(git -C "$plugin_dir" rev-parse HEAD)
  if [[ $head != "$plugin_commit" ]]; then
    if [[ -n $(git -C "$plugin_dir" status --porcelain) ]]; then
      printf 'plugin %s has local changes; left it at %s\n' "$plugin_id" "$head" >&2
      exit 1
    fi
    git -C "$plugin_dir" fetch --quiet origin
    git -C "$plugin_dir" checkout --quiet "$plugin_commit"
  fi
fi

python3 - "$home/.config/omarchy/shell.json" "$plugin_id" << 'PY'
import json, pathlib, sys
path, plugin_id = pathlib.Path(sys.argv[1]), sys.argv[2]
if path.exists():
    data = json.loads(path.read_text())
else:
    data = {"version": 1}
plugins = data.setdefault("plugins", [])
entry = next((item for item in plugins if isinstance(item, dict) and item.get("id") == plugin_id), None)
if entry is None:
    plugins.append({"id": plugin_id})
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n")
PY

quake_src=$(mktemp -d)
cleanup() { rm -rf "$quake_src"; }
trap cleanup EXIT
git -C "$quake_src" init -q
git -C "$quake_src" remote add origin "$quake_url"
git -C "$quake_src" fetch --depth 1 --quiet origin "$quake_commit"
git -C "$quake_src" checkout --quiet FETCH_HEAD
"$quake_src/install"

current=$(omarchy theme current 2>/dev/null || true)
if [[ $current != "$theme" ]]; then
  omarchy theme set "$theme"
fi

if command -v hyprctl >/dev/null && [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  hyprctl reload >/dev/null
fi

printf 'Desktop setup installed. Three-finger swipe up opens NittyGriddy. Super+` opens the Quake console. Reopen Files to pick up its background.\n'
